Banking System

class Bank {
    double getInterest() {
        return 0;
    }
}

class SBI extends Bank {
    @Override
    double getInterest() {
        return 7.5;
    }
}

class HDFC extends Bank {
    @Override
    double getInterest() {
        return 8.2;
    }
}

public class Main {
    public static void main(String[] args) {
        Bank b1 = new SBI();
        Bank b2 = new HDFC();
        System.out.println("SBI Interest = " + b1.getInterest());
        System.out.println("HDFC Interest = " + b2.getInterest());
    }
}

